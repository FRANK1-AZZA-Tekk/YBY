# YBY Hub — exemplo de variáveis de ambiente
# Copie para .env e preencha apenas com valores reais.
# Nunca envie o arquivo .env para o GitHub.

# Open WebUI
WEBUI_AUTH=true
WEBUI_SECRET_KEY=troque_por_uma_chave_aleatoria_longa
DEFAULT_MODELS=qwen2.5:3b-instruct-q4_K_M

# Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_CONTEXT_LENGTH=4096

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Pesquisa externa — opcional
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=

# GitHub — use apenas em um MCP server local ou secret manager
GITHUB_TOKEN=

# Google / Gmail / Calendar — use OAuth e menor privilégio
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Segurança
YBY_APPROVAL_REQUIRED=true
YBY_ALLOWED_WRITE_PATHS=./workspace
YBY_LOG_LEVEL=info
