{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yby.dev/contracts/event.schema.json",
  "title": "YBY Event Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "timestamp", "source", "payload"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "correlation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "event_type": {"enum": ["device_connected", "device_disconnected", "telemetry_received", "command_requested", "command_completed", "command_failed", "provider_called", "ui_rendered"]},
    "timestamp": {"type": "string", "minLength": 1},
    "source": {"enum": ["device", "backend", "provider", "frontend", "system"]},
    "payload": {"type": "object"}
  }
}
